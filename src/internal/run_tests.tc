function run_tests() {
    line total_tests = 0;
    line tests_failed: list[str] = [];

    print("",style="Custom");

    line running_tests = {};

    //=- test execution -=\\
    line "passed_%var(test_name)": num;
    for (local test_name of test_list) {
        total_tests += 1;
        running_tests[test_name] = 1;
        start test_dispatcher(tests_failed, running_tests, localVariables="Copy");
    }

    while (!var.isEmpty(running_tests)) {
        wait;
        allPlayers.sendActionBar(s"Waiting on: ",running_tests.getKeys().join(", "));
    }
    allPlayers.sendActionBar(s"<green>Finished!");

    //=- final result message -=\\
    if (var.isEmpty(tests_failed)) {
        print(s"<green>✔</green> All %var(total_tests) tests passed :D",style="Custom");
    } else {
        print("",style="Custom");
        line total_failed = tests_failed.len();
        line total_passed = total_tests - total_failed;
        
        // generate the hover text containing all failed texts
        line tests_msg = "";
        for (line test of tests_failed) {
            if (tests_msg != "") {
                tests_msg += "\n";
            }
            tests_msg += "<grey>• </grey>%var(test)";
        }
        line tests_msg: txt = txt.parseExpression(tests_msg);

        // failure message
        print(s"<hover:show_text:'%var(tests_msg)'><red>❌</red> Only %var(total_passed)/%var(total_tests) tests passed <grey>(%var(total_failed) failed, hover for list)",style="Custom");
    }
    print("",style="Custom");
}

process test_dispatcher(tests_failed: var[list[str]], running_tests: var[dict]) {
    start "test_%var(test_name)"(localVariables="Share");
    if (test_info_suspends) {
        repeat (MAX_TIME_TICKS) {
            wait;
            if (exit_code) { break; }
        }
    }

    running_tests.remove(test_name);

    if (exit_code == "passed") {
        // print(s"<green>Test <white>%var(test_name)<green> passed!");
    } else {
        tests_failed.append(test_name);
        
        if (exit_code == "failed") {
            // taken care of by the statement call
        } else {
            if (statement_num == 0) {
                print(s"<red>Test <white>%var(test_name)</white> did not finish execution. Not a single statement ran, was this test configured incorrectly?",);
            } else {
                print(s"<red>Test <white>%var(test_name)</white> did not finish execution. The last statement run was <white>%var(last_statement_name) <grey>(#%var(statement_num))",); 
            }
        }
    } 
}
