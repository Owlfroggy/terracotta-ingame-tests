function CONFIG() {
    /** The maximum amount of time suspending tests are allowed to take before they are considered failed. */
    declare global MAX_TIME_TICKS = 40;

    declare global test_list: list[str] = [
        "num_literal",
        "num_expr_literal",

        "str_literal",

        "vec_constructor",
        "vec_component_access",

        "loc_constructor",
        "loc_coordinate_access",

        "item_constructor",

        "par_ids",
        "par_setvars",

        "pot_ids",
        "pot_setvars",
        
        "snd_ids",
        "snd_setvars",

        "list_initialization",
        "list_indexer_get",
        "list_indexer_set",
        "list_trim",

        "dict_initialization",
        "dict_indexer_get",
        "dict_indexer_set",
        "dict_indexer_sob",

        "bvar_main",

        "expr_multivalue",
        "expr_assignment_typecasting",
        "expr_num_plus_num",
        "expr_num_times_num",
        "expr_num_minus_num",
        "expr_num_div_num",
        "expr_num_pow_num",
        "expr_num_remainder_num",
        "expr_num_modulo_num",
        "expr_bitwise",
        "expr_vec_plus_vec",
        "expr_vec_minus_vec",
        "expr_vec_times_vec",
        "expr_vec_div_vec",

        "cond_if_else",
        "cond_and",
        "cond_or",
        "cond_not",

        "control_wait",

        "item_setvars",
    ];
}
