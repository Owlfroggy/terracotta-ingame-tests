process test_cond_and() {
    require_equal("true && true == true", 1 && 1, 1);
    require_equal("true && false == false", 1 && 0, 0);
    require_equal("false && true == false", 0 && 1, 0);
    require_equal("false && false == false", 0 && 0, 0);

    // short circuit testing
    line first_ran: num; line second_ran: num;
    
    // true && true
    first_ran = 0; second_ran = 0;
    line a = util_runchecker(first_ran,1) && util_runchecker(second_ran,1);
    require_equal("true && true runs a", first_ran, 1);
    require_equal("true && true runs b", second_ran, 1);
    
    // true && false
    first_ran = 0; second_ran = 0;
    line a = util_runchecker(first_ran,1) && util_runchecker(second_ran,0);
    require_equal("true && false runs a", first_ran, 1);
    require_equal("true && false runs b", second_ran, 1);
    
    // false && true
    first_ran = 0; second_ran = 0;
    line a = util_runchecker(first_ran,0) && util_runchecker(second_ran,1);
    require_equal("false && true runs a", first_ran, 1);
    require_equal("false && true skips b", second_ran, 0);
    
    // false && false
    first_ran = 0; second_ran = 0;
    line a = util_runchecker(first_ran,0) && util_runchecker(second_ran,0);
    require_equal("false && false runs a", first_ran, 1);
    require_equal("false && false skips b", second_ran, 0);

    line dingus = 0;
    if (1 && 1 && 0) {
        
    } else {
        dingus = 1;
    }
    require_equal("Else works properly with && optimization", dingus, 1);

    pass_test();
}