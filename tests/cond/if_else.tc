process test_cond_if_else {
    line a;
    if (1 == 1) {
        a = 1;
    }
    
    require_equal("If statement ran",a, 1);
    
    line b;
    if (0 == 1) {
        b = 0;
    } else {
        b = 1;
    }
    
    require_equal("Else statement ran", line b, 1);
    
    line c = 0;
    if (0 == 1) {
        
    } else if (1 == 0) {

    } else if (1 == 1) {
        c = 1;
    } else {
        c = 99;
    }
    
    require_equal("Else if statement ran", c, 1);
    
    line d = 0;
    if (0 == 1) {

    } else if (0 == 1) {
        
    } else {
        d = 1;
    }
    
    require_equal("Else if statements were skipped", c, 1);
    
    pass_test();
}
