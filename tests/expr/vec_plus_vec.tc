process test_expr_vec_plus_vec() {
    require_equal("Between constants", vec(1, 2, 3) + vec(4, 5, 6), vec(5, 7, 9));

    line a = vec(1, 2, 3);
    line b = vec(4, 5, 6);
    require_equal("Line var + line var", line a + line b, vec(5, 7, 9));

    line a = vec(1, 2, 3);
    line b = vec(0, 0, 0);
    local b = vec(4, 5, 6);
    require_equal("Line var + local var (with conflicting line)", line a + local b, vec(5, 7, 9));

    local a = vec(1, 2, 3);
    local b = vec(4, 5, 6);
    require_equal("Local var + local var", local a + local b, vec(5, 7, 9));

    line a = vec(1, 2, 3);
    line b = vec(4, 5, 6);
    line c = line a + line b;
    require_equal("Result used in expression", line c + vec(1, 1, 1), vec(6, 8, 10));

    require_equal(
        "Full precision is preserved",
        vec(1)/3 + vec(1)/3,
        vec(0.6666666667)
    );

    pass_test();
}
