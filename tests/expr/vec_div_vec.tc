process test_expr_vec_div_vec() {
    require_equal("Between vectors", vec(10, 12, 14) / vec(2, 3, 7), vec(5, 4, 2));
    require_equal("Vector divided by number", vec(10, 12, 14) / 2, vec(5, 6, 7));

    line a = vec(10, 12, 14);
    line b = vec(2, 3, 7);
    require_equal("Line var / line var", line a / line b, vec(5, 4, 2));

    line a = vec(10, 12, 14);
    line b = vec(1, 1, 1);
    local b = vec(2, 3, 7);
    require_equal("Line var / local var (with conflicting line)", line a / local b, vec(5, 4, 2));

    line a = vec(10, 12, 14);
    line b = vec(2, 3, 7);
    line c = line a / line b;
    require_equal("Result used in expression", line c / 2, vec(2.5, 2, 1));

    require_equal(
        "Vector division by a vector preserves full precision",
        vec(2) / vec(3),
        vec(0.6666666667)
    );

    require_equal(
        "Vector division by a number preserves full precision",
        vec(2) / 3,
        vec(0.6666666667)
    );

    pass_test();
}
