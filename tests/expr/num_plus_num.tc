process test_expr_num_plus_num() {
    require_equal("Between constants",1 + 1,2);

    line a = 1;
    line b = 1;
    require_equal("Line var + line var",line a+line b,2);

    line a = 1;
    line b = 0;
    local b = 1;
    require_equal("Line var + local var (with conflicting line)",line a + local b,2);

    local a = 1;
    local b = 1;
    require_equal("Local var + local var", local a + local b, 2);

    line a = 1;
    line b = 1;
    line c = 1;
    require_equal("Three line vars",line a + line b + line c, 3);

    line a = 1;
    line b = 1;
    line c = line a + line b;
    require_equal("Whatever this is",line c + 1, 3);

    line sum = num.add([1,2,3,4,5,6]);
    require_equal("num.add() with list properly sums", sum, 21);

    pass_test();
}