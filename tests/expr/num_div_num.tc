process test_expr_num_div_num() {
    require_equal("Between constants", 15 / 3, 5);

    line a = 15;
    line b = 3;
    require_equal("Line var / line var", line a / line b, 5);

    line a = 15;
    line b = 1;
    local b = 3;
    require_equal("Line var / local var (with conflicting line)", line a / local b, 5);

    local a = 15;
    local b = 3;
    require_equal("Local var / local var", local a / local b, 5);

    line a = 120;
    line b = 3;
    line c = 2;
    require_equal("Three line vars", line a / line b / line c, 20);

    line a = 15;
    line b = 3;
    line c = line a / line b;
    require_equal("Result used in expression", line c / 5, 1);

    line sum = num.divide([6,2,3]);
    require_equal("num.divide() with list", sum, 1);
    
    sum = 0;
    line sum = num.divide(6,2,3);
    require_equal("num.divide() with inlined plural", sum, 1);

    pass_test();
}
