process test_loc_constructor() {
    // BUG HERE (maybe?): presence of an expression drops precision in other components
    line l = loc(1+1,3,0.0005, 90, 45);
    
    require_equal("X is set", loc.getCoordinate(l, coord="X"), 2);
    require_equal("Y is set", loc.getCoordinate(l, coord="Y"), 3);
    require_equal("Z is set", loc.getCoordinate(l, coord="Z"), 0.0005);
    require_equal("Pitch is set", loc.getCoordinate(l, coord="Pitch"), 90);
    require_equal("Yaw is set", loc.getCoordinate(l, coord="Yaw"), 45);

    pass_test();
}